generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  published   Boolean   @default(true)
  products    Product[]
}

model Product {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String
  price       Decimal?
  priceNote   String?
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  featured    Boolean        @default(false)
  published   Boolean        @default(true)
  sortOrder   Int            @default(0)
  dimensions  String?
  materials   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  images      ProductImage[]
  inquiries   Inquiry[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  thumbUrl  String?
  alt       String  @default("")
  sortOrder Int     @default(0)
}

model GalleryItem {
  id             String   @id @default(cuid())
  title          String?
  imageUrl       String
  beforeImageUrl String?
  sortOrder      Int      @default(0)
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model SiteSetting {
  key   String @id
  value String
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}
