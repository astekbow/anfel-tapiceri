# Databaza
# - SQLite lokale (per zhvillim/VPS):  DATABASE_URL="file:./dev.db"
# - Supabase/Postgres (per Vercel):    te Supabase -> Connect -> ORMs, kopjoni te dyja:
#   DATABASE_URL me porten 6543 (pooler, ?pgbouncer=true) dhe DIRECT_URL me porten 5432
DATABASE_URL="file:./dev.db"
# DIRECT_URL="postgresql://postgres.xxxx:FJALEKALIMI@aws-0-rajoni.pooler.supabase.com:5432/postgres"

# Sekret per sesionet e adminit (min. 32 karaktere te rastesishme)
# Gjeneroje me:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="NDRYSHOJE-ME-NJE-SEKRET-TE-RASTESISHEM-MIN-32-KARAKTERE"

# Llogaria e adminit (krijohet/perditesohet nga "npm run db:seed")
ADMIN_EMAIL="admin@anfel.al"
ADMIN_PASSWORD="vendos-nje-fjalekalim-te-forte"

# URL publike e faqes (perdoret per SEO, sitemap dhe linket e WhatsApp)
# Ne prodhim: https://domeni-juaj.al
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Folderi ku ruhen fotot e ngarkuara (perdoret vetem kur s'ka Supabase Storage)
UPLOAD_DIR="./uploads"

# Supabase Storage (opsionale lokalisht, E NEVOJSHME ne Vercel qe te punoje upload-i i fotove)
# Merren nga Supabase -> Settings -> API (Project URL + service_role key)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
